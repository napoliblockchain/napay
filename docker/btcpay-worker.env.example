# Dedicated worker environment; never reuse the backoffice .env or source this as shell.
# CLI is currently one-shot, merchant-account only. No production worker service is enabled yet.
APP_ENV=prod
APP_DEBUG=false
NAPAY_DB_ROLE_MODE=true
NAPAY_DB_ROLE=worker
DB_DATABASE=napay
DB_DSN=mysql:host=mysql;port=3306;dbname=napay
DB_USERNAME=napay_worker
NAPAY_DB_PASSWORD_FILE=/run/secrets/napay_db_worker_password
NAPAY_WORKER_RUNTIME_PATH=/tmp/napay-btcpay-worker

# Match the approved deployment database and egress proxy. Origin has no path/trailing slash.
# BTCPAY_PROVISION_INSTANCE in the web env is SHA-256 of this exact origin (public metadata).
BTCPAY_PROVISION_ORIGIN=
PAYMENT_PROXY=http://egress:3128
BTCPAY_PROVISION_CA_FILE=
BTCPAY_PROVISIONER_KEY_FILE=/run/secrets/btcpay_provisioner_key
BTCPAY_KEK_KEYRING_FILE=/run/secrets/btcpay_kek_keyring
