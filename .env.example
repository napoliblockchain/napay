# Copy to .env, restrict permissions (chmod 600), then fill required values.
# Single-line KEY=value syntax; quotes are optional. No shell interpolation.
APP_ENV=prod
APP_DEBUG=false
NAPAY_HTTP_PORT=18120

DB_DSN="mysql:host=host.docker.internal;port=3306;dbname=napay"
DB_USERNAME=napay
DB_PASSWORD=

# Preserve existing key values when migrating encrypted data and sessions.
COOKIE_VALIDATION_KEY=
SECRET_HASH_KEY=

ADMIN_NAME=Napay
ADMIN_PHONE=
ADMIN_EMAIL=admin@example.invalid
APP_WEBSITE=https://napay.local
DEFAULT_TIME_ZONE=UTC
LOCAL_TIME_ZONE=Europe/Rome
WEBAPP_SOCIETY=Napay
WEBAPP_LINK=https://napay.local
