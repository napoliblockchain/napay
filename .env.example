# Copy to .env, restrict permissions (chmod 600), then fill required values.
# Single-line KEY=value syntax; quotes are optional. No shell interpolation.
APP_ENV=prod
APP_DEBUG=false
# Enable only when all browser traffic reaches the application through HTTPS.
HTTPS_ONLY=false
NAPAY_HTTP_PORT=18120

DB_DSN="mysql:host=mysql;port=3306;dbname=napay"
DB_DATABASE=napay
DB_USERNAME=napay
DB_PASSWORD=

# Create this external volume explicitly; never share it with poawallet.
NAPAY_MYSQL_VOLUME=napay_mysql_data
# Absolute path OUTSIDE this repository, containing a single-line root password.
# Mounted only into MySQL, not the application. Do not put root password in .env.
NAPAY_MYSQL_ROOT_SECRET_FILE=

# Private directory outside repository: napay-v2.sql + manifest.json, read-only.
NAPAY_IMPORT_DIR=
# Match the owner of the private dataset directory (id -u / id -g).
NAPAY_BOOTSTRAP_UID=1000
NAPAY_BOOTSTRAP_GID=1000
NAPAY_DB_WAIT_SECONDS=120
NAPAY_BOOTSTRAP_SECONDS=1800
NAPAY_STACK_WAIT_SECONDS=3600
NAPAY_MYSQL_START_PERIOD=60s
NAPAY_MYSQL_HEALTH_RETRIES=30

# Preserve existing key values when migrating encrypted data and sessions.
COOKIE_VALIDATION_KEY=
SECRET_HASH_KEY=

ADMIN_NAME=Napay
ADMIN_PHONE=
ADMIN_EMAIL=admin@example.invalid
APP_WEBSITE=https://napay.local
DEFAULT_TIME_ZONE=UTC
LOCAL_TIME_ZONE=Europe/Rome
WEBAPP_SOCIETY=Napay
WEBAPP_LINK=https://napay.local

# No actual delivery by default; private messages saved under runtime/mail.
MAIL_TRANSPORT=file
# SMTP is opt-in; smtp requires STARTTLS, smtps uses implicit TLS. Peer checks stay on.
MAIL_SMTP_SCHEME=smtps
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# TIP-020: import automatico dell'associazione dalla vecchia app Yii1, a ogni avvio finché impostato.
# Utente MySQL con solo SELECT sul DB legacy. Vuoto = nessun import. Togliere dopo lo spegnimento del vecchio.
LEGACY_DB_DSN=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
# Cartella host dei PDF dei verbali (<app legacy>/protected/verbali), montata in sola lettura.
NAPAY_LEGACY_FILES_DIR=

# TIP-020 5b: pagamento quota con PayPal Checkout (Orders v2). Vuote = PayPal non disponibile.
# Credenziali "REST API app" dal developer dashboard PayPal; iniziare da sandbox.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook (equivalente del vecchio IPN): ID del webhook registrato nell'app PayPal per
# https://<dominio napay>/api/paypal/v1/webhook. Vuoto = webhook disattivato.
PAYPAL_WEBHOOK_ID=
