# Copy to a private environment file (chmod 600), then fill required values.
# The role overlay requires NAPAY_ENV_FILE outside this repository.
# Single-line KEY=value syntax; quotes are optional. No shell interpolation.
APP_ENV=prod
APP_DEBUG=false
# Enable only when all browser traffic reaches the application through HTTPS.
HTTPS_ONLY=false
NAPAY_HTTP_PORT=18120

DB_DSN="mysql:host=mysql;port=3306;dbname=napay"
DB_DATABASE=napay
DB_USERNAME=napay_web
DB_PASSWORD=

# Create this external volume explicitly; never share it with poawallet.
NAPAY_MYSQL_VOLUME=napay_mysql_data
# Absolute path OUTSIDE this repository, containing a single-line root password.
# Base stack: MySQL only. Role overlay: MySQL and bootstrap, never web.
# Do not put the root password in the environment file.
NAPAY_MYSQL_ROOT_SECRET_FILE=

# Private directory outside repository: napay-v2.sql + manifest.json, read-only.
NAPAY_IMPORT_DIR=
# Match the owner of the private dataset directory (id -u / id -g).
NAPAY_BOOTSTRAP_UID=1000
NAPAY_BOOTSTRAP_GID=1000
NAPAY_DB_WAIT_SECONDS=120
NAPAY_BOOTSTRAP_SECONDS=1800
NAPAY_STACK_WAIT_SECONDS=3600
NAPAY_MYSQL_START_PERIOD=60s
NAPAY_MYSQL_HEALTH_RETRIES=30

# Preserve existing key values when migrating encrypted data and sessions.
COOKIE_VALIDATION_KEY=
SECRET_HASH_KEY=

ADMIN_NAME=Napay
ADMIN_PHONE=
ADMIN_EMAIL=admin@example.invalid
APP_WEBSITE=https://napay.local
# Optional login/topbar shortcuts. Use public HTTPS origins in production.
NAPAY_WALLET_APP_URL=
NAPAY_POS_APP_URL=
DEFAULT_TIME_ZONE=UTC
LOCAL_TIME_ZONE=Europe/Rome
WEBAPP_SOCIETY=Napay
WEBAPP_LINK=https://napay.local

# No actual delivery by default; private messages saved under runtime/mail.
MAIL_TRANSPORT=file
# SMTP is opt-in; smtp requires STARTTLS, smtps uses implicit TLS. Peer checks stay on.
MAIL_SMTP_SCHEME=smtps
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# TIP-020: import automatico dell'associazione dalla vecchia app Yii1, a ogni avvio finché impostato.
# Utente MySQL con solo SELECT sul DB legacy. Vuoto = nessun import. Togliere dopo lo spegnimento del vecchio.
LEGACY_DB_DSN=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
# Cartella host dei PDF dei verbali (<app legacy>/protected/verbali), montata in sola lettura.
NAPAY_LEGACY_FILES_DIR=

# TIP-020 5b: pagamento quota con PayPal Checkout (Orders v2). Vuote = PayPal non disponibile.
# Credenziali "REST API app" dal developer dashboard PayPal; iniziare da sandbox.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook (equivalente del vecchio IPN): ID del webhook registrato nell'app PayPal per
# https://<dominio napay>/api/paypal/v1/webhook. Vuoto = webhook disattivato.
PAYPAL_WEBHOOK_ID=

# TIP-020 5c: pagamento quota in Bitcoin con BTCPay Server (API Greenfield). Vuote = Bitcoin non disponibile.
# Chiave API limitata allo store: solo "Crea fatture" e "Vedi fatture". Guida: documentazione napay.
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
# Secret del webhook https://<dominio napay>/api/btcpay/v1/webhook (minimo 16 caratteri)
BTCPAY_WEBHOOK_SECRET=
# SIP-030 punto 4: gestione dei negozi dei merchant sullo stesso server BTCPAY_URL, con una chiave distinta
# (permessi sugli store dei merchant, non su quello delle quote). Vuota = impostazioni BTCPay dei negozi non disponibili.
# Ponte fino alle chiavi per merchant di SIP-022 (modello P3). SIP-030 passo 5: con la stessa chiave il cron
# (btcpay-bridge/sync) crea webhook e app POS delle casse dei negozi v1; serve BTCPAY_URL = BTCPAY_PROVISION_ORIGIN.
BTCPAY_STORES_API_KEY=
# SIP-022 xpub: rete Bitcoin del server BTCPay (mainnet, testnet, regtest). Vuota = mainnet. Le xpub dei merchant
# devono essere della stessa rete; Napay mostra i primi indirizzi prima della conferma.
BTCPAY_BTC_NETWORK=
# SIP-022 passo 4: chiave madre (64 caratteri esadecimali) da cui si deriva il segreto del webhook di ogni store.
# Stesso valore del file BTCPAY_STORE_WEBHOOK_KEY_SECRET_FILE del worker. URL pubblico raggiungibile da BTCPay.
BTCPAY_STORE_WEBHOOK_KEY=
BTCPAY_STORE_WEBHOOK_URL=
BTCPAY_STORE_WEBHOOK_KEY_SECRET_FILE=

# SIP-022 role overlay: include docker-compose.roles.yml, stop writers before bootstrap.
# Web DB_USERNAME must be a dedicated napay_* account (e.g. napay_web).
# Different random passwords >=32 bytes, private files 0600 outside repository.
# Only bootstrap sees root+migrator; worker sees only its own mounted secret.
NAPAY_DB_MIGRATOR_USERNAME=napay_migrator
NAPAY_DB_WORKER_USERNAME=napay_worker
NAPAY_DB_MIGRATOR_SECRET_FILE=
NAPAY_DB_WORKER_SECRET_FILE=

# SIP-022 web outbox only: public SHA-256 of the worker's exact HTTPS origin.
# Empty = no provisioning jobs. Never put provisioner keys or KEKs in this app env.
# Distinct from BTCPAY_URL/BTCPAY_API_KEY used for association fees above.
BTCPAY_PROVISION_INSTANCE=
